# --- Telegram ---
# Получить у @BotFather
TELEGRAM_BOT_TOKEN=

# ID пользователей, которым разрешён доступ. Через запятую.
# Свой ID узнать: написать @userinfobot
ALLOWED_USER_IDS=

# --- Claude ---
# Ключ из console.anthropic.com. Либо, если используешь подписку Claude,
# оставь пустым и залогинься внутри контейнера через `claude setup-token`.
ANTHROPIC_API_KEY=

CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high

# --- Агент ---
# Рабочая папка агента. Всё, что он читает/пишет — здесь.
AGENT_WORKSPACE=/data/workspace
# Путь к БД сессий
DB_PATH=/data/bot.db
# Лимит стоимости одного запроса в долларах
MAX_BUDGET_USD=2.0
# Максимум шагов агента за один запрос
MAX_TURNS=60
