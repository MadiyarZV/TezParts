# --- Telegram ---
# Get a token from @BotFather in Telegram: /newbot
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat id — the bot only talks to this chat.
# Get it from @userinfobot (send it any message, it replies with your id).
ADMIN_CHAT_ID=

# --- Anthropic (content generation) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Brand voice ---
BUSINESS_NAME=TezParts
NICHE_DESCRIPTION=контрактные автозапчасти и кузовные детали, разбор авто, редкие детали
BRAND_VOICE_NOTES=тёплый неформальный тон на русском, без канцелярита, без AI-штампов (leverage/delve и т.п.), без длинных тире, хук в первой строке, максимум один хэштег

# --- Scheduling (cron-style, server local time) ---
DAILY_POST_HOUR=9
DAILY_POST_MINUTE=0

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
